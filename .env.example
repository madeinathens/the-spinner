# WalletConnect Cloud Project ID — required for QR-code wallet connections
# Get one free at https://cloud.walletconnect.com (takes ~2 min)
# Without this, only injected wallets (MetaMask) and Coinbase Wallet will work.
VITE_WALLETCONNECT_PROJECT_ID=0000000000000000000000000000000000000
